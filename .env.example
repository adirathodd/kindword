DATABASE_URL=postgres://postgres:postgres@localhost:5432/reviews
# 32+ random chars; signs email unsubscribe links (openssl rand -base64 32)
UNSUBSCRIBE_SECRET=
# Public base URL for review links (/r/...) and unsubscribe links (/u/...), no trailing slash
APP_BASE_URL=
# Physical postal address (PO box or registered private mailbox) for the CAN-SPAM email footer
MAIL_POSTAL_ADDRESS=
# AI reply drafts. DRAFT_PROVIDER: groq (default, free tier, turn on Zero Data Retention in the Groq console) or
# anthropic (paid fallback, Claude Haiku 5.5). DRAFT_MODEL optionally overrides that provider's default model
DRAFT_PROVIDER=
DRAFT_MODEL=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Twilio (SMS). Account SID (AC…) and auth token from the Twilio console; the auth token signs inbound webhooks
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Exact URL set as the incoming-message webhook in Twilio; defaults to APP_BASE_URL + /api/sms/inbound
TWILIO_WEBHOOK_URL=
# Resend (email). API key (re_…) and the sending address on a domain verified in Resend (SPF, DKIM, DMARC).
# EMAIL_FROM_ADDRESS is a plain address (hello@mail.example.com), no display name: the app adds "Kindword"
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# Owner self-serve sign-up (FR-24). "true" opens /account/register; leave unset until the terms and privacy wording is final (FR-23)
SIGNUP_OPEN=
# Where new-sign-up notices and operator alerts (failed review requests, owner emails and opt-out confirmations,
# expired Google access, review check not run in 3 hours) go
OPERATOR_EMAIL=
# Google Sheet intake (FR-2a): our service account, which owners add to their sheet as a viewer. client_email and
# private_key from the service account's JSON key; a one-line key with \n escapes is fine
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
# Google Business Profile (FR-11): the OAuth client owners grant access to (business.manage), and a 32+ char secret
# that encrypts each location's stored refresh token (openssl rand -base64 32). Never reuse UNSUBSCRIBE_SECRET
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_TOKEN_SECRET=
