DATABASE_URL=postgres://postgres:postgres@localhost:5432/reviews
# 32+ random chars; signs email unsubscribe links (openssl rand -base64 32)
UNSUBSCRIBE_SECRET=
# Public base URL for review links (/r/...) and unsubscribe links (/u/...), no trailing slash
APP_BASE_URL=
# Physical postal address (PO box or registered private mailbox) for the CAN-SPAM email footer
MAIL_POSTAL_ADDRESS=
# Twilio (SMS). Account SID (AC…) and auth token from the Twilio console; the auth token signs inbound webhooks
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Exact URL set as the incoming-message webhook in Twilio; defaults to APP_BASE_URL + /api/sms/inbound
TWILIO_WEBHOOK_URL=
# Claude API (AI reply drafts). The SDK reads ANTHROPIC_API_KEY; ANTHROPIC_DRAFT_MODEL overrides the default model
ANTHROPIC_API_KEY=
ANTHROPIC_DRAFT_MODEL=
