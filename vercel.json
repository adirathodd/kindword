{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/jobs/route.ts": {
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "jobs", "maxDeliveries": 6 }]
    }
  },
  "schedules": {
    "sheet-intake": { "schedule": "*/15 * * * *", "topic": "jobs" },
    "review-requests": { "schedule": "*/15 * * * *", "topic": "jobs" },
    "reviews": { "schedule": "*/15 * * * *", "topic": "jobs" },
    "owner-digest": { "schedule": "0 * * * *", "topic": "jobs" },
    "purge": { "schedule": "30 6 * * *", "topic": "jobs" }
  }
}
